# 1. Matikan Directory Listing
Options -Indexes

# 2. Blokir 403 Forbidden untuk akses langsung ke config.php, script.js, .htaccess, dll.
<FilesMatch "^(\.htaccess|config\.php|script\.js|database\.sql|akun_login\.txt|.*\.pdf)$">
  Require all denied
</FilesMatch>

# 3. Paksa browser user selalu mengambil versi terbaru saat di-refresh
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|js|css|php)$">
    FileETag None
    Header unset ETag
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>
</IfModule>
